{
  "name": "template-landing",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "landings/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "template-app"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "pnpm run build:landing && node scripts/assemble-app.mjs",
        "cwd": "landings"
      }
    }
  }
}
